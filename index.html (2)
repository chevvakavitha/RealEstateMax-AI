const MODEL_META = {"rows":208,"sale_valid_price":121,"sale_valid_ppsf":107,"model_mae":556.3769583464257,"model_r2":-0.011149383041930916};
const charts = {};
const state = {status:'all', area:'all'};
const $ = id => document.getElementById(id);

function uniq(key, arr=filteredData) {
  return [...new Set(arr.map(d=>d[key]).filter(v=>v!==null && v!==undefined && v!==''))].sort((a,b)=>String(a).localeCompare(String(b),undefined,{numeric:true}));
}
function nums(a){return a.filter(v=>v!==null && v!==undefined && isFinite(Number(v))).map(Number);}
function median(a){a=nums(a).sort((x,y)=>x-y); if(!a.length)return null; const m=Math.floor(a.length/2); return a.length%2?a[m]:(a[m-1]+a[m])/2;}
function avg(a){a=nums(a); return a.length?a.reduce((x,y)=>x+y,0)/a.length:null;}
function fmtINR(v){
  if(v===null||v===undefined||!isFinite(Number(v)))return '—';
  v=Number(v);
  if(Math.abs(v)>=1e7)return '₹'+(v/1e7).toFixed(2)+' Cr';
  if(Math.abs(v)>=1e5)return '₹'+(v/1e5).toFixed(2)+' L';
  return '₹'+Math.round(v).toLocaleString('en-IN');
}
function fmtCompact(v){
  if(v===null||v===undefined||!isFinite(Number(v)))return '—';
  v=Number(v);
  if(Math.abs(v)>=1e7)return '₹'+(v/1e7).toFixed(2)+' Cr';
  if(Math.abs(v)>=1e5)return '₹'+(v/1e5).toFixed(1)+' L';
  return '₹'+Math.round(v).toLocaleString('en-IN');
}
function pct(v){return v===null||v===undefined||!isFinite(Number(v))?'—':Number(v).toFixed(1)+'%';}
function destroy(id){if(charts[id]){charts[id].destroy();delete charts[id];}}
function palette(n){return ['#3b82f6','#8b5cf6','#22d3ee','#10b981','#f59e0b','#f43f5e','#60a5fa','#a78bfa','#14b8a6','#fbbf24'];}
const gridColor='rgba(59,130,246,0.10)', tickColor='#71819b';

function baseOptions(legend=false){
  return {responsive:true,maintainAspectRatio:false,animation:{duration:450},
    plugins:{legend:{display:legend,labels:{color:'#94a3b8',font:{family:'Space Grotesk',size:10},boxWidth:10}}},
    scales:{x:{grid:{color:gridColor},ticks:{color:tickColor,font:{size:9}}},y:{grid:{color:gridColor},ticks:{color:tickColor,font:{size:9}}}}
  };
}
function filteredData(){
  let a=RAW_DATA.slice();
  const loc=$('f-locality').value, prop=$('f-property').value, bhk=$('f-bhk').value;
  if(loc)a=a.filter(d=>String(d.Standard_Locality)===loc);
  if(prop)a=a.filter(d=>String(d.Property_Type)===prop);
  if(bhk)a=a.filter(d=>String(d.BHK_Category)===bhk);
  if(state.status!=='all')a=a.filter(d=>d.Status===state.status);
  if(state.area!=='all')a=a.filter(d=>d.Area_Available===state.area);
  const lo=Number($('f-price-min').value), hi=Number($('f-price-max').value);
  a=a.filter(d=>d.Price_INR===null || (Number(d.Price_INR)>=lo && Number(d.Price_INR)<=hi));
  return a;
}
function saleData(a){return a.filter(d=>d.Market_Type==='Sale' && d.Price_INR!==null);}
function rentalData(a){return a.filter(d=>d.Market_Type==='Long-Term Rental'||d.Market_Type==='Short-Term Rental');}

function populateFilters(){
  $('f-locality').innerHTML='<option value="">All Localities</option>'+uniq('Standard_Locality',RAW_DATA).map(x=>`<option>${x}</option>`).join('');
  $('f-property').innerHTML='<option value="">All Property Types</option>'+uniq('Property_Type',RAW_DATA).map(x=>`<option>${x}</option>`).join('');
  $('f-bhk').innerHTML='<option value="">All Configurations</option>'+uniq('BHK_Category',RAW_DATA).map(x=>`<option>${x}</option>`).join('');
  const markets=uniq('Market_Type',RAW_DATA);
  $('f-market').innerHTML=markets.map((m,i)=>`<label class="checkbox-item"><input type="checkbox" value="${m}" checked onchange="applyFilters()"><span>${m}</span></label>`).join('');
}
function setToggle(group,btn){
  btn.parentElement.querySelectorAll('.toggle-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active'); state[group]=btn.dataset.value; applyFilters();
}
function updatePriceLabel(){
  $('price-min-label').textContent=fmtINR(Number($('f-price-min').value));
  $('price-max-label').textContent=Number($('f-price-max').value)>=140000000?'₹14 Cr+':fmtINR(Number($('f-price-max').value));
}
function applyFilters(){renderAll();}
function resetFilters(){
  $('f-locality').value='';$('f-property').value='';$('f-bhk').value='';
  $('f-price-min').value=0;$('f-price-max').value=140000000;
  state.status='all';state.area='all';
  document.querySelectorAll('.toggle-group').forEach(g=>{g.querySelectorAll('.toggle-btn').forEach((b,i)=>b.classList.toggle('active',i===0));});
  document.querySelectorAll('#f-market input').forEach(x=>x.checked=true);
  updatePriceLabel();renderAll();
}
function selectedMarkets(){
  return [...document.querySelectorAll('#f-market input:checked')].map(x=>x.value);
}
function getFiltered(){
  let a=filteredData();
  const markets=selectedMarkets();
  if(markets.length<a.length)a=a.filter(d=>markets.includes(d.Market_Type));
  return a;
}

function renderKPIs(a){
  const s=saleData(a), pps=nums(s.map(d=>d.Price_Per_Sqft));
  const opp=s.filter(d=>d.Pricing_Position==='Potentially Underpriced').length;
  $('listings-count').textContent=a.length.toLocaleString('en-IN');
  $('kpi-total').textContent=a.length.toLocaleString('en-IN');
  $('kpi-sale').textContent=s.length.toLocaleString('en-IN');
  $('kpi-median').textContent=fmtINR(median(s.map(d=>d.Price_INR)));
  $('kpi-ppsf').textContent=ppS(median(pps));
  $('kpi-opps').textContent=opp.toLocaleString('en-IN');
  $('kpi-r2').textContent=Number(MODEL_META.model_r2).toFixed(2);
}
function ppS(v){return v===null?'—':'₹'+Math.round(v).toLocaleString('en-IN');}

function renderMarketMix(a){
  destroy('market');
  const counts={};a.forEach(d=>counts[d.Market_Type]=(counts[d.Market_Type]||0)+1);
  charts.market=new Chart($('chart-market-mix'),{type:'doughnut',data:{labels:Object.keys(counts),datasets:[{data:Object.values(counts),backgroundColor:['#3b82f6','#8b5cf6','#22d3ee','#64748b'],borderColor:'#0d1526',borderWidth:3}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{position:'bottom',labels:{color:'#94a3b8',font:{size:9},boxWidth:10}}}}});
}
function renderLocalityPrice(a){
  destroy('locprice');const s=saleData(a), loc=uniq('Standard_Locality',s).map(l=>({l,v:median(s.filter(d=>d.Standard_Locality===l).map(d=>d.Price_INR))})).filter(x=>x.v!==null).sort((x,y)=>y.v-x.v);
  charts.locprice=new Chart($('chart-locality-price'),{type:'bar',data:{labels:loc.map(x=>x.l),datasets:[{label:'Median Sale Price',data:loc.map(x=>x.v),backgroundColor:'#3b82f6',borderRadius:5}]},
  options:{...baseOptions(false),indexAxis:'y',plugins:{tooltip:{callbacks:{label:c=>fmtINR(c.raw)}},legend:{display:false}},scales:{x:{grid:{color:gridColor},ticks:{color:tickColor,callback:v=>fmtINR(v)}},y:{grid:{display:false},ticks:{color:tickColor,font:{size:9}}}}}});
}
function renderPropertyMix(a){
  destroy('ptype');const c={};a.forEach(d=>c[d.Property_Type]=(c[d.Property_Type]||0)+1);
  const entries=Object.entries(c).sort((x,y)=>y[1]-x[1]);
  charts.ptype=new Chart($('chart-property-mix'),{type:'polarArea',data:{labels:entries.map(x=>x[0]),datasets:[{data:entries.map(x=>x[1]),backgroundColor:palette(entries.length).map(x=>x+'cc'),borderColor:'#0d1526',borderWidth:2}]},
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{color:'#94a3b8',font:{size:8},boxWidth:8}}},scales:{r:{grid:{color:gridColor},ticks:{display:false},pointLabels:{color:'#94a3b8',font:{size:8}}}}}});
}
function renderHistogram(a){
  destroy('hist');const s=saleData(a), vals=nums(s.map(d=>d.Price_INR));if(!vals.length)return;
  const lo=Math.min(...vals), hi=Math.max(...vals), bins=10, step=(hi-lo||1)/bins, counts=Array(bins).fill(0);
  vals.forEach(v=>counts[Math.min(bins-1,Math.floor((v-lo)/step))]++);
  const labels=counts.map((_,i)=>fmtCompact(lo+i*step));
  charts.hist=new Chart($('chart-hist'),{type:'bar',data:{labels,datasets:[{label:'Listings',data:counts,backgroundColor:'#8b5cf6aa',borderColor:'#8b5cf6',borderWidth:1,borderRadius:4}]},
  options:{...baseOptions(false),plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{color:tickColor,font:{size:8},maxRotation:35}},y:{grid:{color:gridColor},ticks:{color:tickColor,precision:0}}}}});
}
function renderScatter(a){
  destroy('scatter');const s=saleData(a).filter(d=>d.Area_Sqft!==null&&d.Price_INR!==null);
  const pts=s.map(d=>({x:Number(d.Area_Sqft),y:Number(d.Price_INR),label:d.Listing_ID}));
  charts.scatter=new Chart($('chart-scatter'),{type:'scatter',data:{datasets:[{label:'Sale Listings',data:pts,backgroundColor:'#22d3ee99',borderColor:'#22d3ee',pointRadius:4}]},
  options:{...baseOptions(false),plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>`${c.raw.label||''} · ${Number(c.raw.x).toLocaleString()} sqft · ${fmtINR(c.raw.y)}`}}},
  scales:{x:{grid:{color:gridColor},ticks:{color:tickColor},title:{display:true,text:'Area (sqft)',color:'#71819b',font:{size:9}}},y:{grid:{color:gridColor},ticks:{color:tickColor,callback:v=>fmtINR(v)},title:{display:true,text:'Sale Price',color:'#71819b',font:{size:9}}}}}});
}
function renderBHK(a){
  destroy('bhk');const s=saleData(a), keys=uniq('BHK_Category',s).filter(x=>x!=='Not Applicable');
  const vals=keys.map(k=>median(s.filter(d=>d.BHK_Category===k).map(d=>d.Price_Per_Sqft)));
  charts.bhk=new Chart($('chart-bhk'),{type:'line',data:{labels:keys,datasets:[{label:'Median ₹/sqft',data:vals,borderColor:'#f59e0b',backgroundColor:'#f59e0b22',fill:true,tension:.35,pointBackgroundColor:'#f59e0b',pointRadius:4}]},
  options:{...baseOptions(false),plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>ppS(c.raw)}}},scales:{x:{grid:{display:false},ticks:{color:tickColor}},y:{grid:{color:gridColor},ticks:{color:tickColor,callback:v=>ppS(v)}}}}});
}
function renderHeatmap(a){
  const s=saleData(a), loc=uniq('Standard_Locality',s), bhks=['2 BHK','3 BHK','4 BHK'];
  const vals=loc.map(l=>bhks.map(b=>median(s.filter(d=>d.Standard_Locality===l&&d.BHK_Category===b).map(d=>d.Price_Per_Sqft))));
  const flat=vals.flat().filter(v=>v!==null), lo=Math.min(...flat),hi=Math.max(...flat);
  const bg=v=>v===null?'rgba(255,255,255,.03)':`rgba(59,130,246,${0.15+0.75*((v-lo)/(hi-lo||1))})`;
  const grid=$('heatmap-container');grid.innerHTML=`<div class="heatmap-grid" style="grid-template-columns:120px repeat(${bhks.length},1fr);">${['Locality',...bhks].map(x=>`<div class="heatmap-cell heatmap-label">${x}</div>`).join('')}${loc.map((l,i)=>`<div class="heatmap-cell heatmap-label">${l}</div>`+vals[i].map(v=>`<div class="heatmap-cell" style="background:${bg(v)}">${v===null?'—':ppS(v)}</div>`).join('')).join('')}</div>`;
}
function renderPosition(a){
  destroy('position');const s=saleData(a), labels=['Potentially Underpriced','Market Aligned','Potentially Overpriced','Not Enough Comparables'], vals=labels.map(k=>s.filter(d=>d.Pricing_Position===k).length);
  charts.position=new Chart($('chart-position'),{type:'doughnut',data:{labels,datasets:[{data:vals,backgroundColor:['#10b981','#3b82f6','#f43f5e','#475569'],borderColor:'#0d1526',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'58%',plugins:{legend:{position:'bottom',labels:{color:'#94a3b8',font:{size:8},boxWidth:9}}}}});
}
function renderBenchmark(a){
  destroy('benchmark');const s=saleData(a).filter(d=>(d.Reliable_Benchmark===true||d.Reliable_Benchmark==='True'||d.Reliable_Benchmark==='Yes')&&d.Benchmark_Price_Per_Sqft!==null&&d.Price_Per_Sqft!==null);
  charts.benchmark=new Chart($('chart-benchmark'),{type:'scatter',data:{datasets:[{label:'Comparable Listings',data:s.map(d=>({x:Number(d.Benchmark_Price_Per_Sqft),y:Number(d.Price_Per_Sqft)})),backgroundColor:'#3b82f6aa',borderColor:'#3b82f6',pointRadius:4}]},
  options:{...baseOptions(false),plugins:{legend:{display:false}},scales:{x:{grid:{color:gridColor},ticks:{color:tickColor,callback:v=>ppS(v)},title:{display:true,text:'Benchmark ₹/sqft',color:'#71819b',font:{size:9}}},y:{grid:{color:gridColor},ticks:{color:tickColor,callback:v=>ppS(v)},title:{display:true,text:'Actual ₹/sqft',color:'#71819b',font:{size:9}}}}}});
}
function renderGap(a){
  destroy('gap');const vals=saleData(a).map(d=>d['Price_Gap_%']).filter(v=>v!==null).map(v=>Math.abs(Number(v)));if(!vals.length)return;
  const bins=[0,5,10,15,20,30,50,100], counts=Array(bins.length-1).fill(0);
  vals.forEach(v=>{for(let i=0;i<bins.length-1;i++){if(v>=bins[i]&&v<bins[i+1]){counts[i]++;break}}});
  charts.gap=new Chart($('chart-gap'),{type:'bar',data:{labels:['0–5%','5–10%','10–15%','15–20%','20–30%','30–50%','50%+'],datasets:[{label:'Listings',data:counts,backgroundColor:'#10b981aa',borderColor:'#10b981',borderWidth:1,borderRadius:4}]},options:{...baseOptions(false),plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{color:tickColor,font:{size:8}}},y:{grid:{color:gridColor},ticks:{color:tickColor,precision:0}}}}});
}
function renderModel(a){
  destroy('model');const s=saleData(a).filter(d=>d.Predicted_Market_Price!==null);
  charts.model=new Chart($('chart-model'),{type:'scatter',data:{datasets:[{label:'Model vs Listed',data:s.map(d=>({x:Number(d.Predicted_Market_Price),y:Number(d.Price_INR)})),backgroundColor:'#8b5cf699',borderColor:'#8b5cf6',pointRadius:4}]},
  options:{...baseOptions(false),plugins:{legend:{display:false}},scales:{x:{grid:{color:gridColor},ticks:{color:tickColor,callback:v=>fmtCompact(v)},title:{display:true,text:'Model Estimated Price',color:'#71819b',font:{size:9}}},y:{grid:{color:gridColor},ticks:{color:tickColor,callback:v=>fmtCompact(v)},title:{display:true,text:'Listed Price',color:'#71819b',font:{size:9}}}}}});
}
function renderModelMix(a){
  destroy('modelmix');const s=saleData(a).filter(d=>d.Model_Recommendation);const labels=['Potentially Underpriced','Market Aligned','Potentially Overpriced'],vals=labels.map(k=>s.filter(d=>d.Model_Recommendation===k).length);
  charts.modelmix=new Chart($('chart-model-mix'),{type:'pie',data:{labels,datasets:[{data:vals,backgroundColor:['#10b981','#3b82f6','#f43f5e'],borderColor:'#0d1526',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:'#94a3b8',font:{size:9},boxWidth:9}}}}});
}
function renderRental(a){
  destroy('rental');
  const r=rentalData(a);
  const loc=uniq('Standard_Locality',r);
  const monthly=loc.map(l=>median(r.filter(d=>d.Standard_Locality===l && d.Market_Type==='Long-Term Rental').map(d=>d.Price_Value)));
  const nightly=loc.map(l=>median(r.filter(d=>d.Standard_Locality===l && d.Market_Type==='Short-Term Rental').map(d=>d.Price_Value)));
  charts.rental=new Chart($('chart-rental'),{
    type:'bar',
    data:{
      labels:loc,
      datasets:[
        {label:'Monthly Rent',data:monthly,backgroundColor:'#22d3eeaa',borderColor:'#22d3ee',borderWidth:1,borderRadius:4},
        {label:'Per Night',data:nightly,backgroundColor:'#8b5cf699',borderColor:'#8b5cf6',borderWidth:1,borderRadius:4}
      ]
    },
    options:{
      ...baseOptions(true),
      indexAxis:'y',
      plugins:{
        legend:{position:'bottom',labels:{color:'#94a3b8',font:{size:9},boxWidth:10}},
        tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmtINR(c.raw)}`}}
      },
      scales:{
        x:{grid:{color:gridColor},ticks:{color:tickColor,callback:v=>fmtINR(v)}},
        y:{grid:{display:false},ticks:{color:tickColor,font:{size:8}}}
      }
    }
  });
}
function renderRadar(a){
  destroy('radar');const s=saleData(a);let loc=uniq('Standard_Locality',s);if(!loc.length)return;
  const metrics=loc.map(l=>{const z=s.filter(d=>d.Standard_Locality===l);return {l,n:z.length,p:median(z.map(d=>d.Price_Per_Sqft))||0,o:z.filter(d=>d.Pricing_Position==='Potentially Underpriced').length}});
  metrics.sort((x,y)=>y.n-x.n);const top=metrics.slice(0,5), maxN=Math.max(...metrics.map(x=>x.n),1),maxP=Math.max(...metrics.map(x=>x.p),1);
  const labels=top.map(x=>x.l);
  charts.radar=new Chart($('chart-radar'),{type:'radar',data:{labels,datasets:[{label:'Inventory depth',data:top.map(x=>x.n/maxN*100),borderColor:'#3b82f6',backgroundColor:'#3b82f633',pointBackgroundColor:'#3b82f6'},{label:'Price / sqft index',data:top.map(x=>x.p/maxP*100),borderColor:'#8b5cf6',backgroundColor:'#8b5cf622',pointBackgroundColor:'#8b5cf6'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:'#94a3b8',font:{size:9}}}},scales:{r:{min:0,max:100,grid:{color:gridColor},angleLines:{color:gridColor},pointLabels:{color:'#94a3b8',font:{size:8}},ticks:{display:false}}}}});
}
let tableSort='n',tableDir=-1;
function buildTableData(a){
  return uniq('Standard_Locality',a).map(l=>{const z=a.filter(d=>d.Standard_Locality===l),s=saleData(z);return {
    locality:l,n:z.length,sale:s.length,price:median(s.map(d=>d.Price_INR)),ppsf:median(s.map(d=>d.Price_Per_Sqft)),
    opp:s.length?100*s.filter(d=>d.Pricing_Position==='Potentially Underpriced').length/s.length:0
  };});
}
function renderTable(){
  const a=getFiltered(), q=($('table-search').value||'').toLowerCase();
  let rows=buildTableData(a).filter(x=>x.locality.toLowerCase().includes(q));
  rows.sort((x,y)=>((x[tableSort]??0)-(y[tableSort]??0))*tableDir);
  const max=Math.max(...rows.map(x=>x.n),1);
  $('table-body').innerHTML=rows.map((x,i)=>`<tr><td><span class="rank-badge ${i===0?'gold':i===1?'silver':i===2?'bronze':''}">${i+1}</span></td><td><b>${x.locality}</b></td><td>${x.n}</td><td>${x.sale}</td><td>${fmtINR(x.price)}</td><td>${ppS(x.ppsf)}</td><td>${pct(x.opp)}</td><td><div class="mini-bar-container"><div class="mini-bar-fill" style="width:${x.n/max*100}%"></div></div></td></tr>`).join('') || `<tr><td colspan="8">No matching localities.</td></tr>`;
}
document.querySelectorAll('#market-table th').forEach((th,i)=>{if(i<7)th.addEventListener('click',()=>{const keys=['rank','locality','n','sale','price','ppsf','opp'];tableSort=keys[i];tableDir*=-1;renderTable();});});

function renderInsights(a){
  const s=saleData(a), insights=[];
  const locs=buildTableData(a).sort((x,y)=>y.n-x.n);
  if(locs[0])insights.push(`📍 <strong>Inventory Concentration:</strong> <strong>${locs[0].locality}</strong> has the largest filtered inventory with <strong>${locs[0].n}</strong> listings.`);
  const medP=median(s.map(d=>d.Price_INR)), medPS=median(s.map(d=>d.Price_Per_Sqft));
  if(medP)insights.push(`💰 <strong>Pricing Baseline:</strong> Median sale price is <strong>${fmtINR(medP)}</strong> and the median comparable rate is <strong>${ppS(medPS)}/sqft</strong>.`);
  const opp=s.filter(d=>d.Pricing_Position==='Potentially Underpriced').length;
  if(s.length)insights.push(`✦ <strong>Opportunity Signal:</strong> <strong>${opp}</strong> listings are at least 10% below a reliable comparable benchmark in the current view.`);
  const rental=rentalData(a);
  if(rental.length)insights.push(`🏡 <strong>Rental Lens:</strong> ${rental.length} rental records provide a separate view of monthly and nightly market pricing.`);
  const area=s.filter(d=>d.Area_Sqft!==null);
  if(area.length)insights.push(`📐 <strong>Size Signal:</strong> ${area.length} sale listings contain usable area data for size-price analysis.`);
  const active=a.filter(d=>d.Status==='Active').length;
  const reliable=s.filter(d=>d.Reliable_Benchmark===true).length;
  insights.push(`📌 <strong>Inventory Status:</strong> ${active} of ${a.length} filtered records are currently marked Active.`);
  if(s.length)insights.push(`🧪 <strong>Benchmark Quality:</strong> ${reliable} sale listings have at least 3 comparable records; the remaining sale records should not be treated as reliable benchmark observations.`);
  $('insights-grid').innerHTML=insights.slice(0,6).map(x=>`<div class="insight-card">${x}</div>`).join('');
}

function renderAll(){
  const a=getFiltered();
  renderKPIs(a);
  renderMarketMix(a);
  renderLocalityPrice(a);
  renderPropertyMix(a);
  renderHistogram(a);
  renderScatter(a);
  renderBHK(a);
  renderHeatmap(a);
  renderPosition(a);
  renderBenchmark(a);
  renderGap(a);
  renderModel(a);
  renderModelMix(a);
  renderRental(a);
  renderRadar(a);
  renderTable();
  renderInsights(a);
}
function startClock(){const tick=()=>{$('live-clock').textContent=new Date().toLocaleTimeString('en-IN',{hour12:false});};tick();setInterval(tick,1000);}
window.addEventListener('DOMContentLoaded',()=>{populateFilters();updatePriceLabel();startClock();renderAll();});
</script>

